# ===========================================
# Server Configuration
# ===========================================
PORT=3001
BASE_URL=http://localhost:3001
NODE_ENV=development

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ===========================================
# Database
# ===========================================
# PostgreSQL connection string (Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================================
# OpenRouter API
# ===========================================
# Your OpenRouter API key - required for connecting to AI models
OPENROUTER_API_KEY=your_api_key_here
# Default model for chat
DEFAULT_MODEL_ID=deepseek/deepseek-r1-0528:free
# Model used for auto-generating chat titles
TITLE_GENERATION_MODEL=google/gemini-2.0-flash-001

# ===========================================
# Google OAuth (for SSO)
# ===========================================
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# ===========================================
# Session & Auth
# ===========================================
# Session timeout in days
SESSION_EXPIRY_DAYS=7

# ===========================================
# Paywall Configuration
# ===========================================
# Set to true to disable paywall for development
DISABLE_PAYWALL=true
# Number of free messages per day for free tier users
FREE_MESSAGE_LIMIT=5
# Message counts at which to auto-generate titles (comma-separated)
TITLE_GENERATION_THRESHOLDS=1,3,5

# ===========================================
# Stripe Billing (optional)
# ===========================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_PRO_INDIVIDUAL_MONTHLY=price_xxx
STRIPE_PRICE_PRO_INDIVIDUAL_YEARLY=price_xxx
STRIPE_PRICE_PRO_TEAM_MONTHLY=price_xxx
STRIPE_PRICE_PRO_TEAM_YEARLY=price_xxx
STRIPE_PRICE_PRO_ORGANIZATION_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ORGANIZATION_YEARLY=price_xxx

# ===========================================
# Redis (optional - for session caching)
# ===========================================
# Redis connection for session caching and rate limiting
# If not configured, falls back to PostgreSQL for sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
